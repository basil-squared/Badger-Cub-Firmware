nvic: IRQControllers.NVIC @ sysbus 0xe000e000
    systickFrequency: 1250000000

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m0+"
    nvic: nvic
flash: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x00200000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00042000

resets: Memory.ArrayMemory @ sysbus 0x4000c000
    size: 0x1000

io_bank0: Memory.ArrayMemory @ sysbus 0x40014000
    size: 0x1000

sio: Memory.ArrayMemory @ sysbus 0xd0000000
    size: 0x1000
